    {
      "parameters": {
        "jsCode": "const rows = (name) => $(name).all().map((i) => i.json);\nconst isYes = (v) => ['yes', 'y', 'true', '1'].includes(String(v === undefined || v === null ? '' : v).trim().toLowerCase());\nconst slug = (s) => String(s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');\n\n// 1) Active cities + keywords\nconst cities = rows('Read Cities').filter((r) => r.City && isYes(r.Active)).map((r) => String(r.City).trim());\nconst keywords = rows('Read Keywords').filter((r) => r.Keyword && isYes(r.Active)).map((r) => String(r.Keyword).trim());\nif (!cities.length) throw new Error('Cities tab mein koi city Active = Yes nahi hai.');\nif (!keywords.length) throw new Error('Keywords tab mein koi keyword Active = Yes nahi hai.');\n\n// 2) Run_Config (Setting / Value)\nconst cfg = {};\nrows('Read Run_Config').forEach((r) => { if (r.Setting) cfg[String(r.Setting).trim()] = r.Value; });\nconst modeRaw = String(cfg.Opening_Mode || 'Upcoming').trim().toLowerCase();\nlet modes;\nif (modeRaw === 'upcoming') modes = ['upcoming'];\nelse if (modeRaw === 'recently opened' || modeRaw === 'recent') modes = ['recent'];\nelse if (modeRaw === 'both') modes = ['upcoming', 'recent'];\nelse throw new Error('Run_Config > Opening_Mode galat hai. Sirf: Upcoming / Recently Opened / Both');\n\nconst patterns = {\n  upcoming: ['opening soon', 'coming soon', 'new opening', 'opens next month'],\n  recent: ['now open', 'recently opened', 'newly opened', 'grand opening'],\n};\nconst modeLabel = { upcoming: 'Upcoming', recent: 'Recently Opened' };\n\n// 3) ISO week (e.g. 2026-W43) -> same week dobara run = same Search_ID\nconst isoWeek = (d) => {\n  const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));\n  const day = t.getUTCDay() || 7;\n  t.setUTCDate(t.getUTCDate() + 4 - day);\n  const y = t.getUTCFullYear();\n  const w = Math.ceil(((t - new Date(Date.UTC(y, 0, 1))) / 86400000 + 1) / 7);\n  return y + '-W' + String(w).padStart(2, '0');\n};\nconst week = isoWeek(new Date());\n\n// 4) Already-existing queries (duplicate-safe)\nconst existing = new Set(rows('Read Search_Queue').map((r) => r.Search_ID).filter(Boolean));\n\nconst out = [];\nfor (const city of cities) {\n  for (const keyword of keywords) {\n    for (const m of modes) {\n      patterns[m].forEach((p, idx) => {\n        const id = [week, slug(city), slug(keyword), m, 'p' + (idx + 1)].join('_');\n        if (existing.has(id)) return;\n        existing.add(id);\n        out.push({\n          json: {\n            Search_ID: id,\n            Week: week,\n            City: city,\n            Keyword: keyword,\n            Mode: modeLabel[m],\n            Pattern_No: idx + 1,\n            Query: '\"' + keyword + '\" \"' + city + '\" \"' + p + '\"',\n            Status: 'Pending',\n            Results_Count: '',\n            Last_Run: '',\n            Error_Message: '',\n          },\n        });\n      });\n    }\n  }\n}\nreturn out;"
      },
